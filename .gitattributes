# research/benchmarks/feishu_zh/SOURCE.json pins a sha256 of the raw bytes of the
# frozen dataset and of every archived run, and audit.py verifies them with
# read_bytes(). A checkout that rewrites the line endings (git's default
# core.autocrlf=true on Windows) changes those bytes, so the archive must stay LF
# on every platform.
research/benchmarks/feishu_zh/SOURCE.json text eol=lf
research/benchmarks/feishu_zh/data/** text eol=lf
research/benchmarks/feishu_zh/results/** text eol=lf

# Same reason in research/benchmarks/zh_short_commands: audit.py pins the sha256 of the
# raw bytes of data/cases.jsonl and prompts.py, and a CRLF report.json would make every
# later run on another platform look like a rewrite.
research/benchmarks/zh_short_commands/data/** text eol=lf
research/benchmarks/zh_short_commands/prompts.py text eol=lf
research/benchmarks/zh_short_commands/results/** text eol=lf

# Persian fixtures, prompts and historical runs retain their original byte hashes.
research/benchmarks/persian_fa/SOURCE.json text eol=lf
research/benchmarks/persian_fa/LICENSE text eol=lf
research/benchmarks/persian_fa/data/** text eol=lf
research/benchmarks/persian_fa/prompts.py text eol=lf
research/benchmarks/persian_fa/normalize.py text eol=lf
research/benchmarks/persian_fa/metrics.py text eol=lf
research/benchmarks/persian_fa/results/** text eol=lf
